# Copiar a `.env` y ajustar. `.env` NO se versiona.
#
# Requiere la base corriendo:  docker compose up -d
# (Postgres 16 en el puerto 5440 del host — ver docker-compose.yml)

# `dev`: /docs, /redoc y /openapi.json responden. Con cualquier otro valor son 404 (handoff.md §5.163 c).
ENVIRONMENT=dev

# Postgres-only desde M11.1 (handoff.md §5.2.1). Otros motores fallan al arrancar.
# El host es 127.0.0.1 y NO `localhost` (handoff.md §5.166 a): en Windows `localhost` prueba ::1 primero, el contenedor publica sólo
# 127.0.0.1:5440 y cada conexión nueva cuesta ~2 s (por 127.0.0.1, ~30 ms).
DATABASE_URL=postgresql+psycopg://ippu:ippu@127.0.0.1:5440/ippu

# Base aislada para pytest (M11.5). No debe apuntar a la misma que DATABASE_URL.
TEST_DATABASE_URL=postgresql+psycopg://ippu:ippu@127.0.0.1:5440/ippu_test

# Login mínimo (§5.101). OBLIGATORIA (≥ 32 bytes): sin ella la API no arranca (§5.119). Generarla con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Duración del token (minutos). Vencido, cualquier ruta responde 401 y hay que volver a entrar.
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS: orígenes desde los que el navegador puede llamar a la API, como LISTA JSON.
# La demo HTML conectada se sirve localmente con:
#     cd implementacion/L1-hce-idea/demo && python -m http.server 5500
# y se abre en http://127.0.0.1:5500/index.html?api=http://127.0.0.1:8000 (§5.166 b; abrirla como file:// no sirve: el origen es «null»).
CORS_ORIGINS=["http://localhost:5500","http://127.0.0.1:5500"]
