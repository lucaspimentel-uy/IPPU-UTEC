# Copiar a `.env` y ajustar. `.env` NO se versiona.

ENVIRONMENT=dev

# SQLite (spike local, por defecto):
DATABASE_URL=sqlite:///./ippu.db
# PostgreSQL (Fase 6):
# DATABASE_URL=postgresql+psycopg://ippu:ippu@localhost:5432/ippu

# Auth (Fase 4). Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar-en-produccion
ACCESS_TOKEN_EXPIRE_MINUTES=480
